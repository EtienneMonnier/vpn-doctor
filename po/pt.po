#, python-brace-format
msgid "Diagnostics failed: {error}"
msgstr "O diagnóstico falhou: {error}"

#: src/vpn_doctor/ui/main_window.py:515
msgid "Show"
msgstr "Mostrar"

#: src/vpn_doctor/ui/main_window.py:528
msgid "New or reload connections"
msgstr "Nova ligação ou recarregar"

#: src/vpn_doctor/ui/main_window.py:565
msgid "Click or press a key to skip"
msgstr "Clique ou prima uma tecla para saltar"

#: src/vpn_doctor/ui/main_window.py:613
msgid "Connecting automatically (Preferences)"
msgstr "A ligar automaticamente (Preferências)"

#: src/vpn_doctor/ui/main_window.py:624
msgid "No NetworkManager connection editor is installed"
msgstr "Não está instalado nenhum editor de ligações do NetworkManager"

#: src/vpn_doctor/ui/main_window.py:636
#, python-brace-format
msgid "Cannot open the connection editor: {error}"
msgstr "Não é possível abrir o editor de ligações: {error}"

#: src/vpn_doctor/ui/main_window.py:644
msgid "General"
msgstr "Geral"

#: src/vpn_doctor/ui/main_window.py:647
msgid "Appearance"
msgstr "Aspeto"


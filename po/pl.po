msgstr "■ POŁĄCZENIE"

#: src/vpn_doctor/ui/main_window.py:183
msgid "Settings…"
msgstr "Ustawienia…"

#: src/vpn_doctor/ui/main_window.py:186
msgid "Edit this connection in NetworkManager"
msgstr "Edytuje to połączenie w NetworkManagerze"


msgstr "BRAMA"

#: src/vpn_doctor/ui/main_window.py:196
msgid "MANAGED BY"
msgstr "ZARZĄDZA"

#: src/vpn_doctor/ui/main_window.py:208 src/vpn_doctor/ui/main_window.py:342
msgid "Connect"
msgstr "Połącz"

#: src/vpn_doctor/ui/main_window.py:213
msgid "Disconnect"
msgstr "Rozłącz"

#: src/vpn_doctor/ui/main_window.py:217
msgid "Diagnose"
msgstr "Diagnozuj"

#: src/vpn_doctor/ui/main_window.py:229
msgid "■ LOG"
msgstr "■ DZIENNIK"

#: src/vpn_doctor/ui/main_window.py:306
#, python-brace-format
msgid "Could not send the answer: {error}"
msgstr "Nie można wysłać odpowiedzi: {error}"

#: src/vpn_doctor/ui/main_window.py:311
#, python-brace-format
msgid "{name} asks for more information"
msgstr "Połączenie {name} prosi o więcej informacji"

#: src/vpn_doctor/ui/main_window.py:313
msgid "Send"
msgstr "Wyślij"

#: src/vpn_doctor/ui/main_window.py:330
msgid "Using the password remembered in the keyring"
msgstr "Używanie hasła zapamiętanego w bazie kluczy"

#: src/vpn_doctor/ui/main_window.py:340
#, python-brace-format
msgid "VPN password for {name}"
msgstr "Hasło VPN: {name}"

#: src/vpn_doctor/ui/main_window.py:341
msgid ""
"The password is sent to openfortivpn through stdin, never written to a file."
msgstr ""
"Hasło jest przekazywane do openfortivpn przez standardowe wejście i nigdy "
"nie jest zapisywane w pliku."

#: src/vpn_doctor/ui/main_window.py:352
msgid "Approve this VPN gateway?"
msgstr "Zatwierdzić tę bramę VPN?"

#: src/vpn_doctor/ui/main_window.py:354
#, python-brace-format
msgid ""
"{gateway}\n"
"Certificate: {pin}\n"
"\n"
"An administrator approves a gateway once. Then users of this computer "
"connect to it without an administrator password, and VPN Doctor refuses any "
"other gateway or certificate."
msgstr ""
"{gateway}\n"
"Certyfikat: {pin}\n"
"\n"
"Administrator zatwierdza bramę jednorazowo. Następnie użytkownicy tego "
"komputera łączą się z nią bez hasła administratora, a VPN Doctor odrzuca "
"każdą inną bramę lub certyfikat."

#: src/vpn_doctor/ui/main_window.py:360
msgid "Approve"
msgstr "Zatwierdź"

#: src/vpn_doctor/ui/main_window.py:367
#, python-brace-format
msgid "Approving {gateway}…"
msgstr "Zatwierdzanie {gateway}…"

#: src/vpn_doctor/ui/main_window.py:381
#, python-brace-format
msgid "Connecting {name}…"
msgstr "Łączenie: {name}…"

#: src/vpn_doctor/ui/main_window.py:390
#, python-brace-format
msgid "Could not start the VPN backend: {error}"
msgstr "Nie można uruchomić zaplecza VPN: {error}"

#: src/vpn_doctor/ui/main_window.py:394
msgid "Stopping connection…"
msgstr "Zatrzymywanie połączenia…"

#: src/vpn_doctor/ui/main_window.py:398
#, python-brace-format
msgid "Disconnect failed: {error}"
msgstr "Rozłączenie się nie powiodło: {error}"

#: src/vpn_doctor/ui/main_window.py:405
msgid "Running diagnostics…"
msgstr "Wykonywanie diagnostyki…"

#: src/vpn_doctor/ui/main_window.py:409
#, python-brace-format
msgid "Diagnostics failed: {error}"
msgstr "Diagnostyka się nie powiodła: {error}"

#: src/vpn_doctor/ui/main_window.py:463
msgid "Show"
msgstr "Wyświetl"

#: src/vpn_doctor/ui/main_window.py:476
msgid "Open a connection"
msgstr "Otwórz połączenie"

#: src/vpn_doctor/ui/main_window.py:513
msgid "Click or press a key to skip"
msgstr "Kliknięcie lub naciśnięcie klawisza pomija"

#: src/vpn_doctor/ui/main_window.py:561
msgid "Connecting automatically (Preferences)"
msgstr "Automatyczne łączenie (Preferencje)"

#: src/vpn_doctor/ui/main_window.py:572
msgid "No NetworkManager connection editor is installed"
msgstr "Nie zainstalowano edytora połączeń NetworkManagera"

#: src/vpn_doctor/ui/main_window.py:578
#, python-brace-format
msgid "Cannot open the connection editor: {error}"
msgstr "Nie można otworzyć edytora połączeń: {error}"

#: src/vpn_doctor/ui/main_window.py:586
msgid "General"
msgstr "Ogólne"

#: src/vpn_doctor/ui/main_window.py:589
msgid "Appearance"
msgstr "Wygląd"

#: src/vpn_doctor/ui/main_window.py:595
msgid " (custom)"
msgstr " (własna)"

#: src/vpn_doctor/ui/main_window.py:596
msgid "Skin"
msgstr "Skórka"

#: src/vpn_doctor/ui/main_window.py:608
msgid "Custom skins"
msgstr "Własne skórki"

#: src/vpn_doctor/ui/main_window.py:609
#, python-brace-format
msgid "Drop CSS files in {path}"
msgstr "Pliki CSS należy umieścić w {path}"

#: src/vpn_doctor/ui/main_window.py:611
msgid "Open folder"
msgstr "Otwórz katalog"

#: src/vpn_doctor/ui/main_window.py:611
msgid "Reload"
msgstr "Wczytaj ponownie"

#: src/vpn_doctor/ui/main_window.py:618
msgid "Startup animation"
msgstr "Animacja startowa"

#: src/vpn_doctor/ui/main_window.py:619
msgid "Logo and boot checks when VPN Doctor starts"
msgstr "Logo i testy startowe przy uruchamianiu programu VPN Doctor"

#: src/vpn_doctor/ui/main_window.py:628
msgid "Startup"
msgstr "Uruchamianie"

#: src/vpn_doctor/ui/main_window.py:630
msgid ""
"To connect when the computer starts, without VPN Doctor, use the \"Connect "
"automatically\" option of the connection in NetworkManager."
msgstr ""
"Aby łączyć się przy uruchamianiu komputera bez programu VPN Doctor, należy "
"użyć opcji „Connect automatically” połączenia w NetworkManagerze."

#: src/vpn_doctor/ui/main_window.py:638
msgid "First connection"
msgstr "Pierwsze połączenie"

#: src/vpn_doctor/ui/main_window.py:641
msgid "Default connection"
msgstr "Domyślne połączenie"

#: src/vpn_doctor/ui/main_window.py:647
msgid "Connect automatically"
msgstr "Automatyczne łączenie"

#: src/vpn_doctor/ui/main_window.py:648
msgid "Connect the default connection when VPN Doctor starts"
msgstr "Łączy domyślne połączenie przy uruchamianiu programu VPN Doctor"

#: src/vpn_doctor/ui/main_window.py:667
msgid "Approved gateways"
msgstr "Zatwierdzone bramy"

#: src/vpn_doctor/ui/main_window.py:669
msgid ""
"openfortivpn gateways users of this computer may connect to without an "
"administrator password. Revoking one asks for that password."
msgstr ""
"Bramy openfortivpn, z którymi użytkownicy tego komputera mogą się łączyć bez "
"hasła administratora. Unieważnienie bramy wymaga tego hasła."

#: src/vpn_doctor/ui/main_window.py:676
msgid "No approved gateway yet"
msgstr "Brak zatwierdzonych bram"

#: src/vpn_doctor/ui/main_window.py:679
#, python-brace-format
msgid "Certificate: {pin}"
msgstr "Certyfikat: {pin}"

#: src/vpn_doctor/ui/main_window.py:680 src/vpn_doctor/ui/main_window.py:688
msgid "Revoke"
msgstr "Unieważnij"

#: src/vpn_doctor/ui/main_window.py:688
msgid "Revoked"
msgstr "Unieważniono"

#: src/vpn_doctor/ui/main_window.py:698
msgid "Saved secrets"
msgstr "Zapisane sekrety"

#: src/vpn_doctor/ui/main_window.py:700
msgid ""
"Passwords and PEM pass phrases of openfortivpn profiles, kept in the desktop "

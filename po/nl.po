#: src/vpn_doctor/diagnostics/conflicts.py:127
msgid "Two full tunnels"
msgstr "Twee volledige tunnels"

#: src/vpn_doctor/diagnostics/conflicts.py:129
#, python-brace-format
msgid ""
"{names} both want to carry all your traffic. Only one of them really does."
msgstr ""
"{names} willen allebei al uw verkeer afhandelen. Slechts één ervan doet dat "
"echt."

#: src/vpn_doctor/diagnostics/conflicts.py:132
msgid "Keep one full-tunnel VPN, or ask for split tunneling on the other one."
msgstr ""
"Houd één VPN met volledige tunnel, of vraag om split tunneling voor de "
"andere."

#: src/vpn_doctor/diagnostics/conflicts.py:152
msgid "Overlapping VPN networks"
msgstr "Overlappende VPN-netwerken"

#: src/vpn_doctor/diagnostics/conflicts.py:155
#, python-brace-format
msgid ""
"{first} routes {first_network} and {second} routes {second_network}. Traffic "
"for the overlap goes to {winner} only."
msgstr ""
"{first} routeert {first_network} en {second} routeert {second_network}. "
"Verkeer voor de overlap gaat alleen naar {winner}."

#: src/vpn_doctor/diagnostics/conflicts.py:165
msgid ""
"Disconnect one of these VPNs to reach hosts of the other one, or ask an "
"administrator to use distinct address ranges."
msgstr ""
"Verbreek een van deze VPN's om hosts van de andere te bereiken, of vraag een "
"beheerder om verschillende adresbereiken te gebruiken."

#: src/vpn_doctor/diagnostics/conflicts.py:187
msgid "VPN overlaps your local network"
msgstr "VPN overlapt uw lokale netwerk"

#: src/vpn_doctor/diagnostics/conflicts.py:190
#, python-brace-format
msgid ""
"{vpn} routes {network}, which overlaps your local network {lan_network} on "
"{device}."
msgstr ""
"{vpn} routeert {network}, dat overlapt met uw lokale netwerk {lan_network} "
"op {device}."

#: src/vpn_doctor/diagnostics/conflicts.py:199
msgid ""
"Devices of your local network (router, printer, NAS) or remote hosts may "
"become unreachable. Renumbering the local network avoids it, e.g. "
"192.168.77.0/24 instead of 192.168.1.0/24."
msgstr ""
"Apparaten in uw lokale netwerk (router, printer, NAS) of externe hosts "
"kunnen onbereikbaar worden. Het lokale netwerk hernummeren voorkomt dit, "
"bijv. 192.168.77.0/24 in plaats van 192.168.1.0/24."

#: src/vpn_doctor/diagnostics/conflicts.py:216
msgid "DNS claimed by several VPNs"
msgstr "DNS opgeëist door meerdere VPN's"

#: src/vpn_doctor/diagnostics/conflicts.py:219
#, python-brace-format
msgid ""
"{names} both ask to resolve every name. Answers may come from either VPN, so "
"internal names can fail at random."
msgstr ""
"{names} willen allebei elke naam omzetten. Antwoorden kunnen van beide VPN's "
"komen, waardoor interne namen willekeurig kunnen mislukken."

#: src/vpn_doctor/diagnostics/conflicts.py:223
msgid ""
"Configure routing-only DNS domains (e.g. ~corp.example.com) on one of them "
"in the connection settings, under IPv4 > DNS search domains."
msgstr ""
"Stel op een van beide in de verbindingsinstellingen DNS-domeinen voor alleen "
"routering in (bijv. ~corp.example.com), onder IPv4 > DNS search domains."

#. TRANSLATORS: separator between VPN connection names, as in "Office and Lab".

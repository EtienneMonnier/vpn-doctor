<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>VPN Doctor</vendor>
  <vendor_url>https://github.com/EtienneMonnier/vpn-doctor</vendor_url>
  <icon_name>io.github.vpndoctor.VPNDoctor</icon_name>

  <!--
    The only privileged action of VPN Doctor: start openfortivpn through
    /usr/libexec/vpn-doctor/vpn-doctor-helper, which validates the profile
    and builds the command itself (ADR-0012). Disconnecting needs no
    privilege: VPN Doctor closes the helper's stdin.
  -->
  <action id="io.github.vpndoctor.helper">
    <description>Start a VPN tunnel with openfortivpn</description>
    <message>VPN Doctor needs administrator rights to create the VPN network interface</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/vpn-doctor/vpn-doctor-helper</annotate>
  </action>
</policyconfig>

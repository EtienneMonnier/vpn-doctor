<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>VPN Doctor</vendor>
  <vendor_url>https://github.com/EtienneMonnier/vpn-doctor</vendor_url>
  <icon_name>io.github.vpndoctor.VPNDoctor</icon_name>

  <!--
    The privileged actions of VPN Doctor, all through
    /usr/libexec/vpn-doctor/vpn-doctor-helper (ADR-0012, ADR-0013).
    pkexec selects the action from the helper's first argument.
  -->

  <!-- Connecting reaches only gateways an administrator approved, with their
       pinned certificate, like system connections in NetworkManager. -->
  <action id="io.github.vpndoctor.connect">
    <description>Connect to an approved VPN gateway</description>
    <message>VPN Doctor wants to connect to an approved VPN gateway</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/vpn-doctor/vpn-doctor-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">connect</annotate>
  </action>

  <action id="io.github.vpndoctor.approve">
    <description>Approve a VPN gateway</description>
    <message>Approving a VPN gateway lets users of this computer connect to it. Authentication is required.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/vpn-doctor/vpn-doctor-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">approve</annotate>
  </action>

  <action id="io.github.vpndoctor.revoke">
    <description>Revoke an approved VPN gateway</description>
    <message>Authentication is required to revoke an approved VPN gateway</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/vpn-doctor/vpn-doctor-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">revoke</annotate>
  </action>
</policyconfig>
